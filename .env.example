# ==============================================================================
# BPM - Docker Compose & Frontend Environment
# ==============================================================================
# This file provides environment variables used by docker-compose.yml.
# It mainly orchestrates the database, backend container, and email services.
# The frontend (Vite) runs in the 'root' context but relies on proxying to
# the backend for API calls, so it needs few if any variables itself.

# ------------------------------------------------------------------------------
# PostgreSQL (Docker Container)
# ------------------------------------------------------------------------------
POSTGRES_DB=bpm
POSTGRES_USER=bpm
POSTGRES_PASSWORD=bpm_dev_password

# ------------------------------------------------------------------------------
# Django Container
# ------------------------------------------------------------------------------
# Security
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost

# Carpool board (frontend + backend share an origin in production)
FRONTEND_BASE_URL=https://your-domain.com
CARPOOL_MESSAGE_RETENTION_DAYS=3
# Coarse per-IP hourly request cap for the public carpool endpoints
# (~100 active participants behind one NAT at the default); raise for a
# larger shared-WiFi venue.
CARPOOL_IP_RATE_PER_HOUR=8000

# Email (SendGrid - Optional for Dev, Required for Prod)
SENDGRID_API_KEY=
SMTP_SENDER_EMAIL=noreply@denog.de
SMTP_SENDER_NAME=DENOG Event Team
EMAIL_BCC_ADDRESS=sascha@denog.de

# Pretix Integration (Passed to Django container)
PRETIX_API_TOKEN=
PRETIX_EVENT=
PRETIX_ORGANIZER=denog
PRETIX_CHECKIN_LIST_ID_LOCAL=
PRETIX_CHECKIN_LIST_ID_GLOBAL=

# ------------------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------------------
# VITE_ variables would go here if needed.
# Currently, the frontend proxies API calls to the backend and does not
# require specific environment variables.
