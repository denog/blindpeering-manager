# ==============================================================================
# BPM - Docker Compose & Frontend Environment
# ==============================================================================
# This file provides environment variables used by docker-compose.yml.
# It mainly orchestrates the database, backend container, and email services.
# The frontend (Vite) runs in the 'root' context but relies on proxying to
# the backend for API calls, so it needs few if any variables itself.

# ------------------------------------------------------------------------------
# PostgreSQL (Docker Container)
# ------------------------------------------------------------------------------
POSTGRES_DB=bpm
POSTGRES_USER=bpm
POSTGRES_PASSWORD=bpm_dev_password

# ------------------------------------------------------------------------------
# Django Container
# ------------------------------------------------------------------------------
# Security
DJANGO_SECRET_KEY=change-me-in-production
# Public hostname(s), comma-separated. The internal Docker DNS names
# (APP_CONTAINER_NAME, APP_NETWORK_ALIAS) are added automatically, so a
# reverse proxy can address the app as e.g. bpm:8080 without listing it here.
ALLOWED_HOSTS=localhost

# Carpool board (frontend + backend share an origin in production)
FRONTEND_BASE_URL=https://your-domain.com
CARPOOL_MESSAGE_RETENTION_DAYS=3
# Coarse per-IP hourly request cap for the public carpool endpoints
# (~100 active participants behind one NAT at the default); raise for a
# larger shared-WiFi venue.
CARPOOL_IP_RATE_PER_HOUR=8000

# Email (SendGrid - Optional for Dev, Required for Prod)
SENDGRID_API_KEY=
SMTP_SENDER_EMAIL=noreply@denog.de
SMTP_SENDER_NAME=DENOG Event Team
EMAIL_BCC_ADDRESS=sascha@denog.de

# Pretix Integration (Passed to Django container)
PRETIX_API_TOKEN=
PRETIX_EVENT=
PRETIX_ORGANIZER=denog
PRETIX_CHECKIN_LIST_ID_LOCAL=
PRETIX_CHECKIN_LIST_ID_GLOBAL=

# ------------------------------------------------------------------------------
# Deployment / Reverse Proxy
# ------------------------------------------------------------------------------
# DNS name other containers can proxy to. A containerized Caddy on the shared
# proxy network reaches the app at ${APP_CONTAINER_NAME}:${APP_PORT}
# (or via the alias ${APP_NETWORK_ALIAS}:${APP_PORT}).
# To satisfy an existing Caddy upstream like "blindpeering-app:8000", set
# APP_CONTAINER_NAME=blindpeering-app and APP_PORT=8000.
APP_CONTAINER_NAME=bpm-app
APP_NETWORK_ALIAS=bpm
# Port gunicorn binds inside the container (= the upstream port for Caddy)
APP_PORT=8080
# Host publishing, loopback-only by default so the reverse proxy stays the
# public entry point. APP_BIND_ADDR=0.0.0.0 exposes the app directly.
APP_BIND_ADDR=127.0.0.1
APP_HOST_PORT=8080
# Gunicorn worker processes
GUNICORN_WORKERS=2
# Run `manage.py migrate` automatically on container start (entrypoint).
# This makes `git pull && docker compose up -d --build` a complete deploy.
# Set to false to run migrations manually instead.
AUTO_MIGRATE=true
# To attach the app to a containerized reverse proxy's external network:
# 1) set COMPOSE_FILE and PROXY_NETWORK below, 2) ensure the network exists
#    (docker network create proxy) -- see docker-compose.proxy.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PROXY_NETWORK=proxy

# ------------------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------------------
# VITE_ variables would go here if needed.
# Currently, the frontend proxies API calls to the backend and does not
# require specific environment variables.
