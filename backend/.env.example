# ==============================================================================
# BPM - Backend Environment Configuration
# ==============================================================================
# This file configures the Django application directly when running locally
# (e.g., via `python manage.py runserver`).
# For Docker Compose, see the root .env.example.

# ------------------------------------------------------------------------------
# Django Settings
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=bpm.settings.development

# Security
# DJANGO_SECRET_KEY=secret-key
# ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=bpm
POSTGRES_USER=bpm
POSTGRES_PASSWORD=bpm_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------
# Sender Identity
SMTP_SENDER_EMAIL=noreply@denog.de
SMTP_SENDER_NAME=DENOG Event Team

# Development: Mailpit (Local)
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025

# Production: SendGrid
# SENDGRID_API_KEY=your-sendgrid-key
# EMAIL_BCC_ADDRESS=admin@example.com

# ------------------------------------------------------------------------------
# Pretix Integration
# ------------------------------------------------------------------------------
PRETIX_API_TOKEN=your-pretix-token
PRETIX_ORGANIZER=denog
PRETIX_EVENT=your-event-slug
PRETIX_CHECKIN_LIST_ID_LOCAL=123
PRETIX_CHECKIN_LIST_ID_GLOBAL=456

# ------------------------------------------------------------------------------
# Carpool Board
# ------------------------------------------------------------------------------
# Public origin the frontend is served from; used to build the {carpool_link}
# placeholder in the assignment email. In production this should be the site's
# real domain (frontend and backend share an origin there).
FRONTEND_BASE_URL=http://localhost:5173
# Days after the event that carpool messages/links stay accessible.
CARPOOL_MESSAGE_RETENTION_DAYS=3
# Coarse per-IP request cap/hour for the public carpool endpoints (flood
# backstop; read/write are additionally throttled per token). Default 8000
# ~= 100 concurrently active participants behind one NAT -- raise for a
# larger shared-WiFi venue.
CARPOOL_IP_RATE_PER_HOUR=8000
